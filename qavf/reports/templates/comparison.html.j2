{% from "comparison_macros.html.j2" import verdict_chip %}

<section class="comparisons" aria-label="Dataset comparisons">
{% for view in comparisons %}
  <article class="card comparison" id="{{ view.anchor }}">
    <header>
      {{ verdict_chip(view.verdict) }}
      <h3>{{ view.name }}</h3>
      <span class="sub"><span class="mono">{{ view.baseline }}</span> (baseline) vs <span class="mono">{{ view.candidate }}</span> (candidate) · {{ view.rows }}</span>
    </header>
    <p class="sub">{{ view.counts["passed"] }} check{{ "" if view.counts["passed"] == 1 else "s" }} passed, {{ view.counts["failed"] }} failed, {{ view.counts["not assessed"] }} not assessed.</p>
    {% if view.error %}<p><strong>Not assessed:</strong> {{ view.error }}</p>{% endif %}
    <div class="levels" role="list" aria-label="Verdict per level">
    {% for level in view.levels %}
      <div class="level-tile" role="listitem">
        <div class="name"><a href="#{{ view.anchor }}-{{ loop.index }}">{{ level.name }}</a></div>
        {{ verdict_chip(level.verdict) }}
        <div class="muted">{{ level.counts["passed"] }} passed · {{ level.counts["failed"] }} failed · {{ level.counts["not assessed"] }} not assessed</div>
      </div>
    {% endfor %}
    </div>
    {% if view.alignment %}
    <details><summary>Alignment ({{ view.alignment | length }} step{{ "" if view.alignment | length == 1 else "s" }} and notes)</summary>
      <ol class="notes">{% for step in view.alignment %}<li>{{ step }}</li>{% endfor %}</ol>
    </details>
    {% endif %}
    {% for note in view.notes %}<p class="note">{{ note }}</p>{% endfor %}
    {% for level in view.levels %}
    <details class="level-detail" id="{{ view.anchor }}-{{ loop.index }}" {{ "open" if level.verdict != "passed" else "" }}>
      <summary>{{ level.name }} <span class="muted mono">{{ level.level }}</span> · {{ level.verdict }}</summary>
      {% if level.facts %}<p class="sub">{{ level.facts | join(" · ") }}</p>{% endif %}
      {% if level.charts %}
      <div class="figure-grid">
      {% for chart in level.charts %}
        <figure class="card">
          <figcaption><h3>{{ chart.title }}</h3></figcaption>
          {% if chart.svg %}{{ chart.svg }}{% endif %}
          {% if chart.note %}<p class="note">{{ chart.note }}</p>{% endif %}
        </figure>
      {% endfor %}
      </div>
      {% endif %}
      <div class="scroll">
        <table class="checks">
          <thead><tr><th>Check</th><th>Verdict</th><th>Message</th><th class="num">Affected</th></tr></thead>
          <tbody>
          {% for check in level.checks %}{% include "comparison_check.html.j2" %}{% endfor %}
          </tbody>
        </table>
      </div>
    </details>
    {% endfor %}
  </article>
{% endfor %}
</section>
